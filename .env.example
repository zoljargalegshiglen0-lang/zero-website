# Required
ZERO_ADMIN_PASSWORD=change-this-to-a-strong-password

# Optional Steam profile enrichment
STEAM_WEB_API_KEY=your-steam-web-api-key

# Optional but recommended on Vercel for persistent editing/storage
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional CS2 bridge / relay service
CS2_BRIDGE_URL=https://your-bridge.example.com
CS2_BRIDGE_TOKEN=your-bridge-token

# Notes:
# - Deploy the site on Vercel
# - Connect the repo to GitHub
# - Put real CS2/plugin data behind the bridge URL above
# - The website expects the bridge endpoints documented in COMMUNITY_INTEGRATION.md
